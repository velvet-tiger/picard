{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows",
  "description": "What the Picard window may do. No shell, file system or opener access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-get-status",
    "allow-get-settings",
    "allow-get-appearance",
    "allow-save-settings",
    "allow-preview",
    "allow-run-selected",
    "allow-get-history",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-pick-folder",
    "allow-get-ignored",
    "allow-set-ignored",
    "allow-get-protection",
    "allow-get-not-activity",
    "allow-check-for-update",
    "allow-open-link"
  ]
}
