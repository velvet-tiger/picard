{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows",
  "description": "What the Settings and Preview windows may do. No shell, file system or opener access.",
  "windows": ["settings", "preview"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-get-status",
    "allow-get-settings",
    "allow-save-settings",
    "allow-preview",
    "allow-run-selected",
    "allow-get-history",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-pick-folder"
  ]
}
